# A URL do projeto (Connect → Project URL). Sempre começa com https:// e
# termina em .supabase.co — NUNCA cole a chave aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# A chave publicável do projeto (Connect → Publishable key), geralmente
# começando com sb_publishable_... (ou "anon public" em projetos antigos).
VITE_SUPABASE_ANON_KEY=sua-chave-aqui
